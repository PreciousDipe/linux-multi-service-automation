[DEFAULT]
bantime  = 1h
findtime = 10m
maxretry = 5
backend  = systemd

[sshd]
enabled  = true
port     = ssh
logpath  = %(sshd_log)s

[nginx-http-auth]
enabled  = true
port     = http,https
logpath  = /var/log/nginx/backend-error.log

[nginx-botsearch]
enabled  = true
port     = http,https
logpath  = /var/log/nginx/backend-access.log